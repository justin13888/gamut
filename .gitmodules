# The AV1 reference codecs — issue #378. `update = none` keeps them out of
# `git submodule update --init --recursive`: together they are ~390 MiB of git objects (~440 MiB
# once checked out), and Cargo
# fetches every submodule when any gamut crate is taken as a git dependency, so a consumer that
# only wants the Rust crates would otherwise pay for both. Only the dev-only oracles under
# `tooling/` need them (`aom-oracle`, `dav1d-oracle`, and `libavif-oracle`, which links dav1d).
# Fetch them explicitly:
#     mise run fetch-av1-oracles
[submodule "third_party/dav1d"]
	path = third_party/dav1d
	url = https://code.videolan.org/videolan/dav1d.git
	update = none
[submodule "third_party/libavif"]
	path = third_party/libavif
	url = https://github.com/AOMediaCodec/libavif.git
[submodule "third_party/libtiff"]
	path = third_party/libtiff
	url = https://gitlab.com/libtiff/libtiff.git
[submodule "third_party/zlib"]
	path = third_party/zlib
	url = https://github.com/madler/zlib.git
[submodule "third_party/libpng"]
	path = third_party/libpng
	url = https://github.com/pnggroup/libpng.git
[submodule "third_party/expat"]
	path = third_party/expat
	url = https://github.com/libexpat/libexpat.git
[submodule "third_party/exiv2"]
	path = third_party/exiv2
	url = https://github.com/Exiv2/exiv2.git
[submodule "third_party/lcms2"]
	path = third_party/lcms2
	url = https://github.com/mm2/Little-CMS
# `update = none` — see the dav1d entry at the top of this file. aom is almost all of the cost
# (~380 MiB of the ~390 MiB): `mise run fetch-av1-oracles`.
[submodule "third_party/aom"]
	path = third_party/aom
	url = https://aomedia.googlesource.com/aom
	update = none
[submodule "third_party/libjpeg-turbo"]
	path = third_party/libjpeg-turbo
	url = https://github.com/libjpeg-turbo/libjpeg-turbo.git
[submodule "third_party/libde265"]
	path = third_party/libde265
	url = https://github.com/strukturag/libde265
[submodule "third_party/kvazaar"]
	path = third_party/kvazaar
	url = https://github.com/ultravideo/kvazaar
[submodule "third_party/libheif"]
	path = third_party/libheif
	url = https://github.com/strukturag/libheif
# Real camera DNG files (CC0) for gamut-dng's real-world conformance tier — issue #174.
# `update = none` keeps it out of `git submodule update --init --recursive`: it is ~178 MiB that
# only `mise run test-dng-real` and the `real-dng` extended-CI job need, and every other job and
# contributor checkout would otherwise pay for it. Fetch it explicitly:
#     mise run fetch-dng-samples
[submodule "gamut-dng-samples"]
	path = third_party/gamut-dng-samples
	url = https://github.com/visualcommons/gamut-dng-samples.git
	update = none
	shallow = true
